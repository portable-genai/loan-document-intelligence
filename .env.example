# B5 Loan / Mortgage Document Intelligence : example environment.
#
# Copy to `.env` and fill in. NEVER commit a real `.env` (it is gitignored). Every var below
# is consumed by config/settings.yaml via ${VAR:-default} interpolation. The local/test
# profile needs NONE of the GCP-specific values : only LOAN_DOC_PROFILE.

# ---------------------------------------------------------------------------
# Profile & project
# ---------------------------------------------------------------------------
# gcp | local | platform | onprem.  'local' is a WORKING offline stack (SDK-free, no API
# key, no emulator): it runs the whole pipeline on a laptop. 'onprem' is the fail-fast
# Google Distributed Cloud migration target. Dev / test default is 'local'.
LOAN_DOC_PROFILE=local

# GCP project id (gcp/platform profiles only).
GOOGLE_CLOUD_PROJECT=your-gcp-project

# ---------------------------------------------------------------------------
# Local profile store (optional). Empty => ~/.loan_doc_intel/audit.db ; tests use :memory:.
# ---------------------------------------------------------------------------
LOAN_DOC_LOCAL_AUDIT=

# Optional higher-fidelity local dev: point the local stores at Google's official emulators
# (these are OFF by default; the SDK-free path needs none of them).
# FIRESTORE_EMULATOR_HOST=localhost:8080

# ---------------------------------------------------------------------------
# Region is PINNED to asia-southeast1 in config/settings.yaml : not an env var.
# Do not add a region override here; residency depends on the pin.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Security / residency (gcp profile)
# ---------------------------------------------------------------------------
# Regional Cloud KMS key for CMEK (projects/.../locations/asia-southeast1/.../cryptoKeys/...)
LOAN_DOC_KMS_KEY=

# ---------------------------------------------------------------------------
# Document extraction : Document AI (gcp profile)
# ---------------------------------------------------------------------------
# Full processor resource name: projects/.../locations/asia-southeast1/processors/...
LOAN_DOC_DOCAI_PROCESSOR=

# ---------------------------------------------------------------------------
# PII redaction : Sensitive Data Protection / DLP (gcp profile)
# ---------------------------------------------------------------------------
LOAN_DOC_DLP_INSPECT_TEMPLATE=
LOAN_DOC_DLP_DEIDENTIFY_TEMPLATE=

# ---------------------------------------------------------------------------
# Cheap runtime controls (docs/runbook.md "Runtime controls"). Unset is ON; true/false
# (or on/off) wins; an emptied value refuses to boot, so leave a line commented rather
# than empty. Under gcp/platform, review routing on needs HUMAN_REVIEW_URL; under gcp it
# also needs HUMAN_REVIEW_IAP_AUDIENCE.
# ---------------------------------------------------------------------------
# LOAN_DOC_GUARDRAIL=true
# LOAN_DOC_PII_REDACTION=true
# LOAN_DOC_REVIEW_ROUTING=true
# Under gcp the deployed console is an embedded app behind the portal's IAP edge, so the URL
# is the edge path for it.
# HUMAN_REVIEW_URL=https://portal.fictional-bank.example/apps/human-review-console/api
# The audience that edge accepts for the hand-off bearer: the deployment's IAP OAuth client id.
# The router mints a Google-signed ID token for it with the service's own identity on every
# submission. NOT the /projects/.../backendServices/... path (that is LOAN_DOC_IAP_AUDIENCE,
# for verifying inbound assertions): a backend-service path here refuses at boot. Unset
# outside gcp keeps the static S2S_TOKEN bearer.
# HUMAN_REVIEW_IAP_AUDIENCE=000000000000-replace-me.apps.googleusercontent.com

# ---------------------------------------------------------------------------
# Identity & embedding surface (see docs/embedding-and-identity.md)
# ---------------------------------------------------------------------------
# Secure-mode identity: the exact IAP-protected resource path the backend verifies the
# x-goog-iap-jwt-assertion audience against (gcp/platform profiles; required to verify).
LOAN_DOC_IAP_AUDIENCE=
# Cross-origin / standalone CORS allowlist (comma-separated origins; NEVER "*"). Same-origin
# reverse-proxy embedding needs no CORS. Empty => localhost dev origins.
LOAN_DOC_CORS_ORIGINS=
# CSP frame-ancestors: parent origins permitted to iframe the UI (space-separated). Default
# 'self' (nothing external may frame it). Example: "https://portal.client.example".
LOAN_DOC_FRAME_ANCESTORS='self'

# ---------------------------------------------------------------------------
# Agent Runtime (set AFTER you deploy the reasoningEngine)
# ---------------------------------------------------------------------------
LOAN_DOC_AGENT_ENGINE=

# ---------------------------------------------------------------------------
# Platform-profile sibling service URLs (platform profile only)
# ---------------------------------------------------------------------------
GUARDRAIL_GATEWAY_URL=http://localhost:8080
AGENT_REGISTRY_URL=http://localhost:8083
OBSERVABILITY_URL=http://localhost:8085
QUALITY_GATE_URL=http://localhost:8084

# ---------------------------------------------------------------------------
# Optional: point at a non-default settings file.
# ---------------------------------------------------------------------------
# LOAN_DOC_SETTINGS=config/settings.yaml
