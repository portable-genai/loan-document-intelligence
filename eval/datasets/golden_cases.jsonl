# Synthetic golden cases for the B5 offline eval gate. All applicant data is fictional.
# Each line: an application (applicant + documents + the extracts the parser would yield),
# the expected deterministic verdict, and which checks are expected to FAIL (if any).
#
# `expected_fields` names, per document, the fields a REVIEWER says that document TYPE must yield
# for the decision to be made without a human re-reading it: exactly what CrossValidator consumes,
# which is `name` and `address` on every document and `net_pay` on a payslip. It is written from
# the document TYPE rather than from the fixture, which is the point, because an oracle taken from
# the fixture agrees with it by construction. `employer` is deliberately NOT required: it is in
# the redactable set but no check reads it, so requiring it would measure a field nothing needs.
#
# The four `pii_in_inputs` cases carry `name` and `address` on every extract and are scored like
# any other case. The runner plants each case's identifier on BOTH sides of NAME_MATCH and
# ADDRESS_MATCH, the applicant record and the documents' copies of it, and also on the bank
# statement's `account_holder`, which is redactable and which no deterministic check reads.
#
# They used to carry no name or address, and with nothing on the documents `_field_match` compared
# the applicant with itself and passed on a single value: four of the ten cases passed two checks
# that had nothing to check. Restoring the fields alone made both checks FAIL on cases a reviewer
# marked consistent, because the pipeline had masked the document values while the applicant value
# still carried the raw identifier. The fix was in the validator, not here: it puts both sides
# through the redactor that masked the extracts, so it compares like with like, and a field no
# document carries is now a WARN rather than a PASS.
{"id": "case-consistent-salaried", "applicant": {"id": "app-f-1001", "name": "Casey Fictional", "address": "1 Test Lane, Singapore 000001", "declared_income": {"amount": 6500.0, "period": "monthly", "kind": "salary"}}, "documents": [{"id": "payslip-1001", "doc_type": "payslip", "uri": "gs://fictional/p1001.pdf"}, {"id": "bank-1001", "doc_type": "bank_statement", "uri": "gs://fictional/b1001.pdf"}], "extracts": [{"document_id": "payslip-1001", "doc_type": "payslip", "title": "Payslip 2026-04", "period": "2026-04", "confidence": 0.96, "fields": {"name": "Casey Fictional", "address": "1 Test Lane, Singapore 000001", "employer": "Fictional Co", "net_pay": "6500.00"}}, {"document_id": "bank-1001", "doc_type": "bank_statement", "title": "Statement 2026-04", "period": "2026-04", "confidence": 0.93, "fields": {"name": "Casey Fictional", "address": "1 Test Lane, Singapore 000001"}, "line_items": [{"label": "Opening balance", "amount": 12000.0, "date": "2026-04-01"}, {"label": "Salary credit", "amount": 6500.0, "date": "2026-04-25"}, {"label": "Closing balance", "amount": 16000.0, "date": "2026-04-30"}]}], "expected_verdict": "verified", "expected_failed_checks": [], "expected_fields": {"payslip-1001": ["name", "address", "net_pay"], "bank-1001": ["name", "address"]}}
