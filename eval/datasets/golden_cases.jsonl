# Per-market PII cases (pii_safety). Each carries its OWN jurisdiction's fictional national
# identifier so breaking one pack row turns exactly one case red; run_eval.py plants the id
# on the applicant (-> the audited prompt) and on the bank statement's account_holder (-> the
# extract the model reads), which are the pipeline's two redaction call sites. These cases
# deliberately omit `name` / `address` from their documents: B5's CrossValidator compares the
# applicant's RAW name/address against the documents' REDACTED copies, so an applicant
# carrying an NRIC would mismatch its own payslip and fail NAME_MATCH. With no document value
# to disagree with, the check sees one value and passes, and pii_safety measures the
# redaction boundary rather than the fixture. All data is fictional.
{"id": "case-pii-sg", "jurisdiction": "SG", "pii_in_inputs": true, "applicant": {"id": "app-f-3001", "name": "Alex Fictional", "address": "7 Example Avenue, Singapore 000007", "declared_income": {"amount": 6500.0, "period": "monthly", "kind": "salary"}}, "documents": [{"id": "payslip-3001", "doc_type": "payslip", "uri": "gs://fictional/p3001.pdf"}, {"id": "bank-3001", "doc_type": "bank_statement", "uri": "gs://fictional/b3001.pdf"}], "extracts": [{"document_id": "payslip-3001", "doc_type": "payslip", "title": "Payslip 2026-04", "period": "2026-04", "confidence": 0.95, "fields": {"employer": "Fictional Co", "net_pay": "6500.00"}}, {"document_id": "bank-3001", "doc_type": "bank_statement", "title": "Statement 2026-04", "period": "2026-04", "confidence": 0.92, "fields": {}, "line_items": [{"label": "Opening balance", "amount": 12000.0, "date": "2026-04-01"}, {"label": "Salary credit", "amount": 6500.0, "date": "2026-04-25"}, {"label": "Closing balance", "amount": 16000.0, "date": "2026-04-30"}]}], "expected_verdict": "verified", "expected_failed_checks": []}
